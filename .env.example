# Copy this file to `.env`. The easiest way to fill in tokens is the hub's
# Tokens button, which shows how to get each one and saves it here.
# `.env` stays on your computer and is never committed to git.

# GitHub: fine-grained personal access token limited to your repos.
# https://github.com/settings/personal-access-tokens
# Permissions: Actions (read & write), Contents (read), Pull requests (read),
# Issues (read), Dependabot alerts (read), Metadata (read).
GITHUB_TOKEN=

# Supabase: scoped personal access token (not a classic one), limited to your
# organization and the projects you show in the hub. Permissions: Project
# Settings (Read and write; Read if you don't need Restore/Pause), Database
# (Read), Backups (Read).
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Netlify: personal access token.
# https://app.netlify.com/user/applications#personal-access-tokens
NETLIFY_TOKEN=

# Vercel: access token scoped to the team your project is in (your Hobby team
# on the free plan).
# https://vercel.com/account/settings/tokens
VERCEL_TOKEN=

# Cloudflare: API token with Zone:Read, Zone Settings:Edit, DNS:Read,
# Cache Purge:Purge and Analytics:Read for your zone.
# https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=

# Resend: API key with "Full access" (a "Sending access" key cannot read
# domains or email history).
# https://resend.com/api-keys
RESEND_API_KEY=

# Port the hub listens on.
HUB_PORT=8787

# Extra host names allowed to open the hub, comma-separated (Tailscale
# *.ts.net addresses are always allowed).
HUB_ALLOWED_HOSTS=
