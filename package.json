{
  "name": "management-hub",
  "version": "1.0.0",
  "description": "A locally hosted dashboard for managing projects",
  "scripts": {
    "dev": "concurrently --kill-others -n server,web -c gray,blue \"node --watch --import tsx --no-warnings=ExperimentalWarning server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "vite build && tsx --no-warnings=ExperimentalWarning server/index.ts",
    "serve": "tsx --no-warnings=ExperimentalWarning server/index.ts",
    "typecheck": "tsc",
    "check-plugins": "tsx --no-warnings=ExperimentalWarning server/check-plugins.ts",
    "test": "node --import tsx --test \"server/**/*.test.ts\""
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@tiptap/extension-color": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "hono": "^4.13.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-grid-layout": "^2.2.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  }
}
